# ─────────────────────────────────────────────────────────────────────────────
# Mascots Sports Cards — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# FormSpree — Contact Form
# 1. Go to https://formspree.io and sign up (free)
# 2. Create a new form, set the destination email to mascotsportscards@gmail.com
# 3. Copy the endpoint URL (looks like https://formspree.io/f/abcd1234)
FORMSPREE_CONTACT_URL=https://formspree.io/f/YOUR_CONTACT_FORM_ID

# FormSpree — Newsletter Signup (optional, create a second form)
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_URL=https://formspree.io/f/YOUR_NEWSLETTER_FORM_ID
