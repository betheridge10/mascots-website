# ─────────────────────────────────────────────────────────────────────────────
# Mascots Sports Cards — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Gmail SMTP — Contact Form
# 1. Go to myaccount.google.com → Security → 2-Step Verification (must be ON)
# 2. Then go to myaccount.google.com → Security → App Passwords
# 3. Create an app password named "Mascots Website"
# 4. Copy the 16-character password (no spaces)
GMAIL_USER=mascotsportscards@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# FormSpree — Newsletter Signup (optional, create a second form)
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_URL=https://formspree.io/f/YOUR_NEWSLETTER_FORM_ID
