# ─────────────────────────────────────────────────────────────────────────────
# Mascots Sports Cards — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Resend — Contact Form
# 1. Sign up free at https://resend.com
# 2. Go to API Keys → Create API Key
# 3. Paste it below and add to Vercel environment variables
RESEND_API_KEY=re_your_api_key_here

# FormSpree — Newsletter Signup (optional, create a second form)
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_URL=https://formspree.io/f/YOUR_NEWSLETTER_FORM_ID
